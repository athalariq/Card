LARPCARD_DISCORD_TOKEN=
LARPCARD_DATABASE_URL=postgresql+asyncpg://larpcard:larpcard@postgres:5432/larpcard
LARPCARD_REDIS_URL=redis://redis:6379/0
LARPCARD_POSTGRES_PORT=5432
LARPCARD_REDIS_PORT=6379
LARPCARD_ASSET_ROOT=/app/assets
LARPCARD_LOG_LEVEL=INFO
LARPCARD_SYNC_COMMANDS_ON_STARTUP=true
LARPCARD_DEV_GUILD_IDS=[123456789012345678]
LARPCARD_CATALOG_CACHE_SECONDS=60
LARPCARD_DROP_MIN_CARDS=2
LARPCARD_DROP_MAX_CARDS=4
LARPCARD_DROP_COOLDOWN_SECONDS=300
LARPCARD_CLAIM_WINDOW_SECONDS=60
